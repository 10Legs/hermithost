## Run `bash scripts/setup.sh` to configure hermithost before first boot.
## Only ACME_EMAIL and NS_HOSTNAME require manual input — setup.sh prompts for them.

# ── Coolify admin account (auto-defaulted by setup.sh) ───────────
# COOLIFY_ADMIN_EMAIL — defaults to the value of ACME_EMAIL (a real address,
#   required by Coolify's email:rfc,dns validator). Override to use a different address.
# COOLIFY_ADMIN_PASSWORD — auto-generated strong password (mixed case, numbers, symbols).
#   The generated password is printed to stdout during setup.sh — save it.
#   Override here before running setup.sh to use your own password.
COOLIFY_ADMIN_EMAIL=
COOLIFY_ADMIN_PASSWORD=

# ── Coolify internal secrets (auto-generated by scripts/setup.sh) ─
# Do not set these manually — setup.sh generates them with openssl rand.
COOLIFY_APP_ID=
COOLIFY_APP_KEY=
COOLIFY_DB_PASSWORD=
COOLIFY_REDIS_PASSWORD=
COOLIFY_PUSHER_APP_ID=
COOLIFY_PUSHER_APP_KEY=
COOLIFY_PUSHER_APP_SECRET=

# ── Coolify API token (auto-provisioned at startup) ───────────────
# Written to /coolify-api-token/token by coolify-server-setup container.
# Leave empty — the API reads from the shared volume at runtime.
COOLIFY_API_TOKEN=

# ── Coolify UI port (optional) ────────────────────────────────────
COOLIFY_PORT=8000

# ── Technitium DNS (auto-provisioned at startup) ──────────────────
# Permanent token written to /coolify-api-token/technitium_token by startup.
# Leave empty — the API reads from the shared volume at runtime.
TECHNITIUM_URL=http://technitium:5380
TECHNITIUM_TOKEN=
# Host port for DNS queries (TCP + UDP — both bound by docker-compose).
# Set by setup.sh: LAN mode → 53; Internet mode → 5353 (avoids system DNS conflict).
# Default 5353 is safe on macOS/Linux where mDNSResponder/systemd-resolved owns 53.
DNS_PORT=5353

# ── Public DNS hostname ───────────────────────────────────────────
# Public IP or hostname of this server (shown in DNS setup guides)
# Prompted by setup.sh if not set.
NS_HOSTNAME=
# Public IPv4 of this server — used for DNS glue records (A record for ns1.<zone>).
# Auto-detected by scripts/setup.sh and coolify-server-setup at boot.
NS_SERVER_IP=

# ── HermitHost Dashboard Auth ─────────────────────────────────────
# Password for the hermithost dashboard login. Required at runtime.
# Prompted by setup.sh if not set.
HERMITHOST_PASSWORD=
# Secret used to sign session cookies (HMAC-SHA256). Required at runtime.
# Derived deterministically by setup.sh from HERMITHOST_PASSWORD + a versioned
# host-scoped salt. Do not set manually — setup.sh manages this value.
# Re-runs with the same password produce the same secret (sessions survive).
# Changing HERMITHOST_PASSWORD rotates the secret and invalidates all sessions.
COOKIE_SECRET=

# ── CORS ─────────────────────────────────────────────────────────
# Allowed origin(s) for the API. Required when cookie-based auth is used —
# browsers reject Access-Control-Allow-Origin: * with credentials: true.
# Single origin:   CORS_ORIGIN=https://hermithost.example.com
# Multiple origins: CORS_ORIGIN=https://hermithost.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:3000

# ── Network port mode (set by setup.sh) ───────────────────────────
# HERMITHOST_PORT_MODE is the single source of truth for both port bindings
# and DNS/certificate mode (network mode is derived, not separately stored):
#   lan      → binds host ports 80/443;   DNS mode = internal (.hh via Technitium, local CA)
#   internet → binds host ports 8080/8443; DNS mode = external (sslip / Let's Encrypt)
# setup.sh prompts on first run; idempotent thereafter.
# To change mode: re-run scripts/setup.sh
HERMITHOST_PORT_MODE=

# ── Traefik host port bindings (set by setup.sh from HERMITHOST_PORT_MODE) ──
TRAEFIK_HTTP_PORT=
TRAEFIK_HTTPS_PORT=

# ── Dashboard URL render ports (set by setup.sh) ──────────────────
# API uses these to format site URLs: https://host when port==443, else host:port
PUBLIC_BASE_PORT_HTTP=
PUBLIC_BASE_PORT_HTTPS=
# Email for Let's Encrypt certificate notifications.
# Prompted by setup.sh if not set.
ACME_EMAIL=
# Only set when using --profile internal (step-ca local CA).
# Leave empty for public Let's Encrypt mode.
# LEGO_CA_CERTIFICATES=/home/step/certs/root_ca.crt
