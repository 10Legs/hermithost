## Run `bash scripts/setup.sh` to auto-generate secrets before first boot.
## Only the fields below require manual input.

# ── GitHub ────────────────────────────────────────────────────────
# Personal access token with repo read access (used to clone private repos)
GITHUB_TOKEN=

# ── Coolify admin account (set before first `docker compose up`) ──
COOLIFY_ADMIN_EMAIL=
COOLIFY_ADMIN_PASSWORD=

# ── Coolify internal secrets (auto-generated by scripts/setup.sh) ─
# Do not set these manually — setup.sh generates them with openssl rand.
COOLIFY_APP_ID=
COOLIFY_APP_KEY=
COOLIFY_DB_PASSWORD=
COOLIFY_REDIS_PASSWORD=
COOLIFY_PUSHER_APP_ID=
COOLIFY_PUSHER_APP_KEY=
COOLIFY_PUSHER_APP_SECRET=

# ── Coolify API token (auto-provisioned at startup) ───────────────
# Written to /coolify-api-token/token by coolify-server-setup container.
# Leave empty — the API reads from the shared volume at runtime.
COOLIFY_API_TOKEN=

# ── Coolify UI port (optional) ────────────────────────────────────
COOLIFY_PORT=8000

# ── Technitium DNS (auto-provisioned at startup) ──────────────────
# Permanent token written to /coolify-api-token/technitium_token by startup.
# Leave empty — the API reads from the shared volume at runtime.
TECHNITIUM_URL=http://technitium:5380
TECHNITIUM_TOKEN=

# ── Public DNS hostname ───────────────────────────────────────────
# Public IP or hostname of this server (shown in DNS setup guides)
NS_HOSTNAME=

# ── Traefik ───────────────────────────────────────────────────────
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443
# Email for Let's Encrypt certificate notifications
ACME_EMAIL=
